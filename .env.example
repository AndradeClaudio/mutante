# Disposable Sepolia testnet wallet. Do NOT use with real money.
# Create one with: node scripts/create-wallet.mjs
TESTNET_PRIVATE_KEY=
WALLET_ADDRESS=

# --- Web version (npm run web, or the Docker image) ---
# Comma-separated access codes for judges and testers, at least 8 characters each. Anyone without one is refused.
ACCESS_CODES=
# Limits that protect the wallet: runs per access code per hour, test USDC per run, and per UTC day for all runs.
RUNS_PER_CODE_PER_HOUR=3
BUDGET_PER_RUN_USDC=0.25
DAILY_CAP_USDC=2
# Wrong access codes one address may try per hour before it is blocked.
FAILED_ATTEMPTS_PER_HOUR=10
# Set to 1 behind a hosting proxy (Render, Fly.io), so limits apply to the visitor's address and not the proxy's.
TRUST_PROXY=0
PORT=8080
DATA_DIR=data/web
